createOrReplace

    ref table Customer
        /// Count of unique customers in the current customer context, not automatically incident-attributed.
        measure 'Total Customers' = DISTINCTCOUNT('Customer'[customer_id])
            formatString: #,##0

    ref table Account
        /// Count of unique accounts.
        measure 'Total Accounts' = DISTINCTCOUNT('Account'[account_id])
            formatString: #,##0

    ref table Subscription
        /// Count of active subscriptions in the current subscription context.
        measure 'Active Subscriptions' = CALCULATE(DISTINCTCOUNT('Subscription'[subscription_id]), 'Subscription'[status] = "Active")
            formatString: #,##0
        /// Monthly recurring revenue across subscriptions, in CAD.
        measure 'Monthly Recurring Revenue' = SUM('Subscription'[monthly_recurring_revenue])
            formatString: $#,##0.00

    ref table 'Network Asset'
        /// Count of network assets in the asset dimension context.
        measure 'Network Assets' = DISTINCTCOUNT('Network Asset'[network_asset_id])
            formatString: #,##0

    ref table Incident
        /// Count of incidents that are not resolved.
        measure 'Open Incidents' = CALCULATE(DISTINCTCOUNT('Incident'[incident_id]), 'Incident'[status] <> "Resolved")
            formatString: #,##0
        /// Count of high severity incidents.
        measure 'High Severity Incidents' = CALCULATE(DISTINCTCOUNT('Incident'[incident_id]), 'Incident'[severity] = "High")
            formatString: #,##0
        /// Resolution hours for resolved timestamps, retaining fractional hours.
        measure 'Average Incident Resolution Hours' = AVERAGEX(FILTER('Incident', NOT ISBLANK('Incident'[resolution_time])), DATEDIFF('Incident'[start_time], 'Incident'[resolution_time], MINUTE) / 60.0)
            formatString: 0.00

    ref table 'Telemetry Event'
        /// Count of telemetry events.
        measure 'Telemetry Events' = COUNTROWS('Telemetry Event')
            formatString: #,##0
        /// Count of critical telemetry events.
        measure 'Critical Telemetry Events' = CALCULATE(COUNTROWS('Telemetry Event'), 'Telemetry Event'[severity_band] = "Critical")
            formatString: #,##0
        /// Average latency in milliseconds under explicit asset/time filters.
        measure 'Average Latency' = CALCULATE(AVERAGE('Telemetry Event'[metric_value]), 'Telemetry Event'[metric_name] = "latency_ms")
            formatString: 0.0" ms"
        /// Packet-loss percentage points: a source value of 2.5 is displayed as 2.50%, not 250%.
        measure 'Average Packet Loss' = CALCULATE(AVERAGE('Telemetry Event'[metric_value]), 'Telemetry Event'[metric_name] = "packet_loss_pct")
            formatString: 0.00"%"

    ref table 'Support Case'
        /// Count of support cases.
        measure 'Support Cases' = DISTINCTCOUNT('Support Case'[case_id])
            formatString: #,##0
        /// Count of escalated support cases.
        measure 'Escalated Cases' = CALCULATE(DISTINCTCOUNT('Support Case'[case_id]), 'Support Case'[case_status] = "Escalated")
            formatString: #,##0
        /// Average synthetic support sentiment score.
        measure 'Average Sentiment' = AVERAGE('Support Case'[sentiment_score])
            formatString: 0.00
        /// Cases per 1,000 active subscriptions; the denominator is the subscription base, not the impact bridge.
        measure 'Complaint Rate per 1000 Subscribers' = DIVIDE([Support Cases] * 1000.0, [Active Subscriptions])
            formatString: 0.00

    ref table 'Work Order'
        /// Count of work orders.
        measure 'Work Orders' = DISTINCTCOUNT('Work Order'[work_order_id])
            formatString: #,##0
        /// Count of P1 work orders.
        measure 'P1 Work Orders' = CALCULATE(DISTINCTCOUNT('Work Order'[work_order_id]), 'Work Order'[priority] = "P1")
            formatString: #,##0

    ref table 'SLA Exposure'
        /// SLA exposure in CAD from the exposure fact, not repeated dispatch context.
        measure 'SLA Exposure Amount' = SUM('SLA Exposure'[exposure_amount])
            formatString: $#,##0.00

    ref table 'Churn Risk'
        /// Customers with high synthetic churn risk in the current customer context.
        measure 'High Churn Risk Customers' = CALCULATE(DISTINCTCOUNT('Churn Risk'[customer_id]), 'Churn Risk'[risk_band] = "High")
            formatString: #,##0
        /// Average synthetic churn-risk score; not incident-attributed churn lift.
        measure 'Average Churn Risk Score' = AVERAGE('Churn Risk'[risk_score])
            formatString: 0.000

    ref table 'Bridge Incident Service'
        /// Distinct impacted service instances through the explicit incident-service bridge.
        measure 'Affected Subscribers' = DISTINCTCOUNT('Bridge Incident Service'[service_instance_id])
            formatString: #,##0
        /// CRM customers on impacted accounts; account-level attribution, not a direct customer-service mapping.
        measure 'Affected Customers' =
                VAR ImpactedServices = VALUES('Bridge Incident Service'[service_instance_id])
                VAR ImpactedSubscriptions = CALCULATETABLE(VALUES('Service Instance'[subscription_id]), KEEPFILTERS(TREATAS(ImpactedServices, 'Service Instance'[service_instance_id])))
                VAR ImpactedAccounts = CALCULATETABLE(VALUES('Subscription'[account_id]), KEEPFILTERS(TREATAS(ImpactedSubscriptions, 'Subscription'[subscription_id])))
                RETURN CALCULATE(DISTINCTCOUNT('Customer'[customer_id]), KEEPFILTERS(TREATAS(ImpactedAccounts, 'Customer'[account_id])))
            formatString: #,##0

    ref table 'Bridge Incident Asset'
        /// Distinct impacted network assets through the explicit incident-asset bridge.
        measure 'Affected Network Assets' = DISTINCTCOUNT('Bridge Incident Asset'[network_asset_id])
            formatString: #,##0

    ref table 'Dispatch Priority'
        /// Gold dispatch score for a single work order; intentionally blank for multi-work-order totals.
        measure 'Dispatch Priority Score' = IF(HASONEVALUE('Dispatch Priority'[work_order_id]), MAX('Dispatch Priority'[dispatch_priority_score]), BLANK())
            formatString: 0.00

    ref table Investigation
        /// Count of saved investigation evidence artifacts.
        measure Investigations = DISTINCTCOUNT('Investigation'[investigation_id])
            formatString: #,##0
        /// Count of confirmed investigation evidence artifacts.
        measure 'Confirmed Investigations' = CALCULATE(DISTINCTCOUNT('Investigation'[investigation_id]), 'Investigation'[status] = "Confirmed")
            formatString: #,##0

