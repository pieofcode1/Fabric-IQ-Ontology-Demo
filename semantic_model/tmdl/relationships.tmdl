createOrReplace

    relationship Account_to_Customer
        fromColumn: Customer.account_id
        toColumn: Account.account_id

    relationship Account_to_Subscription
        fromColumn: Subscription.account_id
        toColumn: Account.account_id

    relationship Product_to_Subscription
        fromColumn: Subscription.product_id
        toColumn: Product.product_id

    relationship Subscription_to_Device
        fromColumn: Device.subscription_id
        toColumn: Subscription.subscription_id

    relationship Subscription_to_Service_Instance
        fromColumn: 'Service Instance'.subscription_id
        toColumn: Subscription.subscription_id

    /// Inactive alternate route: Subscription already filters Service Instance directly.
    relationship Device_to_Service_Instance
        isActive: false
        fromColumn: 'Service Instance'.device_id
        toColumn: Device.device_id

    relationship Network_Asset_to_Service_Instance
        fromColumn: 'Service Instance'.network_asset_id
        toColumn: 'Network Asset'.network_asset_id

    /// Root-cause asset only; keep inactive to avoid competing asset-to-impact routes.
    relationship Network_Asset_to_Incident
        isActive: false
        fromColumn: Incident.network_asset_id
        toColumn: 'Network Asset'.network_asset_id

    relationship Network_Asset_to_Telemetry_Event
        fromColumn: 'Telemetry Event'.network_asset_id
        toColumn: 'Network Asset'.network_asset_id

    /// Alternate asset/telemetry route; Incident is the active alarm filter.
    relationship Telemetry_Event_to_Alarm
        isActive: false
        fromColumn: Alarm.telemetry_event_id
        toColumn: 'Telemetry Event'.telemetry_event_id

    relationship Incident_to_Alarm
        fromColumn: Alarm.incident_id
        toColumn: Incident.incident_id

    relationship Customer_to_Support_Case
        fromColumn: 'Support Case'.customer_id
        toColumn: Customer.customer_id

    /// Account already filters Support Case through Customer.
    relationship Account_to_Support_Case
        isActive: false
        fromColumn: 'Support Case'.account_id
        toColumn: Account.account_id

    /// Alternate subscription/account route; activate only in a purpose-built measure.
    relationship Service_Instance_to_Support_Case
        isActive: false
        fromColumn: 'Support Case'.service_instance_id
        toColumn: 'Service Instance'.service_instance_id

    relationship Incident_to_Support_Case
        fromColumn: 'Support Case'.incident_id
        toColumn: Incident.incident_id

    relationship Incident_to_Work_Order
        fromColumn: 'Work Order'.incident_id
        toColumn: Incident.incident_id

    /// Preserve the asset link without adding another active incident/asset route.
    relationship Network_Asset_to_Work_Order
        isActive: false
        fromColumn: 'Work Order'.network_asset_id
        toColumn: 'Network Asset'.network_asset_id

    relationship Technician_to_Work_Order
        fromColumn: 'Work Order'.technician_id
        toColumn: Technician.technician_id

    relationship Incident_to_SLA_Exposure
        fromColumn: 'SLA Exposure'.incident_id
        toColumn: Incident.incident_id

    relationship Account_to_SLA_Exposure
        fromColumn: 'SLA Exposure'.account_id
        toColumn: Account.account_id

    relationship Customer_to_Churn_Risk
        fromColumn: 'Churn Risk'.customer_id
        toColumn: Customer.customer_id

    relationship Incident_to_Bridge_Incident_Asset
        fromColumn: 'Bridge Incident Asset'.incident_id
        toColumn: Incident.incident_id

    relationship Network_Asset_to_Bridge_Incident_Asset
        fromColumn: 'Bridge Incident Asset'.network_asset_id
        toColumn: 'Network Asset'.network_asset_id

    relationship Incident_to_Bridge_Incident_Service
        fromColumn: 'Bridge Incident Service'.incident_id
        toColumn: Incident.incident_id

    relationship Service_Instance_to_Bridge_Incident_Service
        fromColumn: 'Bridge Incident Service'.service_instance_id
        toColumn: 'Service Instance'.service_instance_id

    relationship Incident_to_Investigation
        fromColumn: Investigation.incident_id
        toColumn: Incident.incident_id

    relationship Incident_to_Dispatch_Priority
        fromColumn: 'Dispatch Priority'.incident_id
        toColumn: Incident.incident_id

    relationship Technician_to_Dispatch_Priority
        fromColumn: 'Dispatch Priority'.technician_id
        toColumn: Technician.technician_id

    relationship Date_to_Incident
        fromColumn: Incident.start_date
        toColumn: Date.date

    /// Use USERELATIONSHIP in a measure when comparing case-open dates rather than incident-start dates.
    relationship Date_to_Support_Case
        isActive: false
        fromColumn: 'Support Case'.opened_date
        toColumn: Date.date

    /// Use USERELATIONSHIP in a measure when comparing work-order-created dates rather than incident-start dates.
    relationship Date_to_Work_Order
        isActive: false
        fromColumn: 'Work Order'.created_date
        toColumn: Date.date

